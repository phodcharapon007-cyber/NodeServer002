<section class="hero py-5">
	<div class="container py-lg-4">
		<p class="eyebrow text-uppercase mb-3">เมนูทั้งหมด</p>
		<h1 class="display-4 fw-bold">รายการไก่ทอดและของทานเล่น</h1>
		<p class="lead text-secondary mt-3 mb-0">เลือกเมนูโปรดจากรายการทั้งหมด <%= totalProducts %> รายการ</p>
	</div>
</section>

<section class="py-5">
	<div class="container">
		<div class="table-responsive rounded-4 border">
			<table class="table table-striped table-hover align-middle menu-table mb-0">
				<thead>
					<tr>
						<th scope="col">ลำดับ</th>
						<th scope="col">รูป</th>
						<th scope="col">ชื่อเมนู</th>
						<th scope="col">รายละเอียด</th>
						<th scope="col" class="text-end">ราคา</th>
						<th scope="col" class="text-center">เมนู</th>
					</tr>
				</thead>
				<tbody>
					<% products.forEach((product, index) => { %>
						<tr>
							<th scope="row"><%= startIndex + index + 1 %></th>
							<td><img class="menu-thumbnail" src="<%= product.image %>" alt="<%= product.name %>"></td>
							<td class="fw-semibold"><%= product.name %></td>
							<td class="text-secondary"><%= product.description %></td>
							<td class="text-end fw-bold text-nowrap">฿<%= product.price %></td>
							<td class="text-center"><a class="btn btn-sm btn-outline-success rounded-pill" href="/product/<%= product.id %>">รายละเอียด</a></td>
						</tr>
					<% }); %>
				</tbody>
			</table>
		</div>
		<div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 mt-4">
			<p class="small text-secondary mb-0">หน้า <%= currentPage %> จาก <%= totalPages %> · แสดง <%= startIndex + 1 %>-<%= startIndex + products.length %> จาก <%= totalProducts %> รายการ</p>
			<nav aria-label="เปลี่ยนหน้ารายการสินค้า">
				<ul class="pagination mb-0">
					<li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
						<a class="page-link" href="/showProduct?page=<%= currentPage - 1 %>" <%= currentPage === 1 ? 'aria-disabled="true" tabindex="-1"' : '' %>>ก่อนหน้า</a>
					</li>
					<% for (let page = 1; page <= totalPages; page++) { %>
						<li class="page-item <%= page === currentPage ? 'active' : '' %>">
							<a class="page-link" href="/showProduct?page=<%= page %>" <%= page === currentPage ? 'aria-current="page"' : '' %>><%= page %></a>
						</li>
					<% } %>
					<li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
						<a class="page-link" href="/showProduct?page=<%= currentPage + 1 %>" <%= currentPage === totalPages ? 'aria-disabled="true" tabindex="-1"' : '' %>>ถัดไป</a>
					</li>
				</ul>
			</nav>
		</div>
		<p class="small text-secondary mt-3 mb-0">ราคาแสดงเป็นเงินบาท</p>
	</div>
</section>
