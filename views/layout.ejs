<!doctype html>
<html lang="th">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="theme-color" content="#c94c0c">
	<title><%= title %> | ไก่กรอบ</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<style>
		:root { --brand: #e85d04; --brand-dark: #c94c0c; --brand-light: #fff1df; }
		body { color: #33241b; background: #fffaf4; }
		.navbar, .footer { background: #2b1a12; }
		.navbar { border-bottom: 3px solid #f4a261; }
		.navbar-brand { font-weight: 800; letter-spacing: -.04em; }
		.nav-link { color: rgba(255,255,255,.85); }
		.nav-link:hover, .nav-link.active { color: #ffc078; }
		.btn-brand { color: #fff; background: var(--brand); border-color: var(--brand); }
		.btn-brand:hover { color: #fff; background: var(--brand-dark); border-color: var(--brand-dark); }
		.btn-outline-success { --bs-btn-color: var(--brand-dark); --bs-btn-border-color: var(--brand); --bs-btn-hover-bg: var(--brand); --bs-btn-hover-border-color: var(--brand); --bs-btn-hover-color: #fff; }
		.hero { background: radial-gradient(ellipse at 82% 30%, #ffe0b5 0, transparent 38%), linear-gradient(110deg, #fff1df, #fffaf4 68%); }
		.hero-image { width: 100%; max-height: 390px; object-fit: cover; border: 6px solid #fff; border-radius: 1.5rem; box-shadow: 0 18px 50px #7f3b1b24; }
		.eyebrow { color: var(--brand); font-weight: 700; letter-spacing: .1em; }
		.category-card, .product-card { background: #fff; border: 1px solid #f0dfcf; transition: transform .2s, box-shadow .2s; }
		.category-card:hover, .product-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px #7f3b1b18; }
		.category-icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 16px; background: var(--brand-light); color: var(--brand-dark); font-size: 1.6rem; }
		.product-card img { height: 190px; object-fit: cover; padding: .5rem; background: #fff; }
		.price { color: var(--brand-dark); font-weight: 800; font-size: 1.1rem; }
		.link-success { color: var(--brand-dark) !important; }
		.link-success:hover { color: #8f3409 !important; }
		.newsletter { background: var(--brand-light); }
		.menu-table { --bs-table-bg: #fff; --bs-table-striped-bg: #fff8ef; --bs-table-border-color: #f0dfcf; }
		.menu-table thead th { color: #6b351b; background: #fff1df; white-space: nowrap; }
		.menu-thumbnail { width: 64px; height: 48px; object-fit: cover; border-radius: .5rem; }
		.pagination { --bs-pagination-color: var(--brand-dark); --bs-pagination-hover-color: #8f3409; --bs-pagination-hover-bg: var(--brand-light); --bs-pagination-hover-border-color: #f0dfcf; --bs-pagination-focus-color: var(--brand-dark); --bs-pagination-focus-box-shadow: 0 0 0 .25rem #e85d0433; --bs-pagination-active-bg: var(--brand); --bs-pagination-active-border-color: var(--brand); --bs-pagination-disabled-color: #9c8b7d; --bs-pagination-border-color: #f0dfcf; }
		.footer a { color: rgba(255,255,255,.8); text-decoration: none; }
		.footer a:hover { color: #ffc078; }
		.content-card { border: 1px solid #f0dfcf; border-radius: 1rem; background: #fff; }
		@media (max-width: 575.98px) { .hero-image { max-height: 260px; } }
	</style>
</head>
<body>
	<header>
		<nav class="navbar navbar-expand-lg navbar-dark">
			<div class="container">
				<a class="navbar-brand fs-4" href="/">ไก่<span class="text-warning">กรอบ</span></a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#siteNav" aria-controls="siteNav" aria-expanded="false" aria-label="เปิดเมนู"><span class="navbar-toggler-icon"></span></button>
				<div class="collapse navbar-collapse" id="siteNav">
					<ul class="navbar-nav mx-auto my-2 my-lg-0 gap-lg-3">
						<li class="nav-item"><a class="nav-link <%= activePage === 'home' ? 'active' : '' %>" href="/" <%= activePage === 'home' ? 'aria-current="page"' : '' %>>หน้าแรก</a></li>
						<li class="nav-item"><a class="nav-link" href="/#categories">เมนูอาหาร</a></li>
						<li class="nav-item"><a class="nav-link <%= activePage === 'product' ? 'active' : '' %>" href="/product" <%= activePage === 'product' ? 'aria-current="page"' : '' %>>สินค้า</a></li>
						<li class="nav-item"><a class="nav-link <%= activePage === 'about' ? 'active' : '' %>" href="/about" <%= activePage === 'about' ? 'aria-current="page"' : '' %>>เกี่ยวกับเรา</a></li>
						<li class="nav-item"><a class="nav-link" href="/about#contact">ติดต่อเรา</a></li>
					</ul>
					<a class="btn btn-warning fw-semibold rounded-pill px-4" href="/product">สั่งความอร่อย →</a>
				</div>
			</div>
		</nav>
	</header>

	<main><%- body %></main>

	<footer class="footer text-white pt-5 pb-3">
		<div class="container">
			<div class="row g-4 pb-4">
				<div class="col-md-5"><a class="navbar-brand fs-4 text-white text-decoration-none" href="/">ไก่<span class="text-warning">กรอบ</span></a><p class="text-white-50 mt-3">ไก่ทอดกรอบและเฟรนช์ฟรายส์ทอดใหม่ อร่อยได้ทุกวัน</p></div>
				<div class="col-6 col-md-3"><h2 class="h6 fw-bold">เมนู</h2><ul class="list-unstyled d-grid gap-2 small"><li><a href="/">หน้าแรก</a></li><li><a href="/#categories">เมนูอาหาร</a></li><li><a href="/product">สินค้า</a></li><li><a href="/about">เกี่ยวกับร้าน</a></li></ul></div>
				<div class="col-6 col-md-4"><h2 class="h6 fw-bold">ติดต่อเรา</h2><p class="small text-white-50 mb-1">อีเมล: hello@crispy.example</p><p class="small text-white-50 mb-0">โทร: 02-123-4567</p></div>
			</div>
			<hr class="border-light opacity-25">
			<p class="small text-white-50 text-center mb-0">© 2025 ไก่กรอบ. สงวนลิขสิทธิ์</p>
		</div>
	</footer>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
